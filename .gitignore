# ── Python ───────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Secrets & Config — NEVER commit these ─────────
# Google OAuth credentials: keep the real files local.
# client_secret.example.json shows the shape and is the only one committed.
client_secret*.json
!client_secret.example.json
youtube_token*.json
youtube_token*.pickle

# Environment files
.env
.env.*
!.env.example

# User settings and backups
settings*.json
settings*.json.tmp
*.pickle
*.pkl

# ── SSL/TLS & Reverse Proxy Credentials ──
# Certificates, private keys, and auth files from Cloudflare/Nginx setup
*.pem
*.key
*.crt
*.csr
*.cer
*.pfx
*.p12
.htpasswd

# ── Downloaded fonts (fetched from Google Fonts on first run) ──
assets/fonts/

# ── Generated output — large files ───────
output/
output/images/
*.mp4
*.mp3
*.wav
*.webp
*.gif
*.jpg
*.jpeg
*.png
# allow docs screenshots
!docs/screenshots/*.png

# ── Temporary & backup files ─────────────
*.tmp
*.bak
*~

# ── Testing & Coverage ───────────────────
.pytest_cache/
.coverage
htmlcov/
.cache/

# ── OS junk ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE ───────────────────────────────────
.vscode/
.idea/
.cursor/
.zed/
*.swp
*.swo

# ── Logs ─────────────────────────────────
*.log
# ── Project memory ───────────────────────
Antigravity.md
GEMINI.md
